generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PATIENT
  DRIVER
  ADMIN
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFFLINE
}

enum AmbulanceType {
  BASIC
  ICU
  CARDIAC
}

enum AmbulanceStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
}

enum RequestPriority {
  CRITICAL
  HIGH
  NORMAL
}

enum RequestStatus {
  PENDING
  ASSIGNED
  EN_ROUTE_PICKUP
  PICKED_UP
  EN_ROUTE_HOSPITAL
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id         String    @id @default(cuid())
  name       String
  email      String    @unique
  password   String?
  phone      String?
  role       Role      @default(PATIENT)
  googleId   String?   @unique
  isVerified Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  driverProfile     DriverProfile?
  emergencyRequests EmergencyRequest[] @relation("patientRequests")
  statusLogs        RequestStatusLog[]
  payments          Payment[]
  feedbackGiven     Feedback[]         @relation("feedbackPatient")
  feedbackReceived  Feedback[]         @relation("feedbackDriver")
  refreshTokens     RefreshToken[]
  assignedRequests  EmergencyRequest[] @relation("driverRequests")

  @@index([role])
}

model DriverProfile {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id])
  licenseNumber String       @unique
  status        DriverStatus @default(OFFLINE)
  currentLat    Float?
  currentLng    Float?
  ambulanceId   String?
  ambulance     Ambulance?   @relation(fields: [ambulanceId], references: [id])
  updatedAt     DateTime     @updatedAt

  @@index([status])
}

model Ambulance {
  id             String          @id @default(cuid())
  plateNumber    String          @unique
  type           AmbulanceType   @default(BASIC)
  status         AmbulanceStatus @default(AVAILABLE)
  homeHospitalId String?
  homeHospital   Hospital?       @relation(fields: [homeHospitalId], references: [id])
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  drivers  DriverProfile[]
  requests EmergencyRequest[]

  @@index([status])
}

model Hospital {
  id        String    @id @default(cuid())
  name      String
  address   String
  lat       Float
  lng       Float
  phone     String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  ambulances          Ambulance[]
  destinationRequests EmergencyRequest[]

  @@index([name])
}

model EmergencyRequest {
  id                    String          @id @default(cuid())
  patientId             String
  patient               User            @relation("patientRequests", fields: [patientId], references: [id])
  pickupAddress         String
  pickupLat             Float
  pickupLng             Float
  priority              RequestPriority @default(NORMAL)
  status                RequestStatus   @default(PENDING)
  ambulanceId           String?
  ambulance             Ambulance?      @relation(fields: [ambulanceId], references: [id])
  driverId              String?
  driver                User?           @relation("driverRequests", fields: [driverId], references: [id])
  destinationHospitalId String?
  destinationHospital   Hospital?       @relation(fields: [destinationHospitalId], references: [id])
  cancelReason          String?
  requestedAt           DateTime        @default(now())
  assignedAt            DateTime?
  completedAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  statusLogs RequestStatusLog[]
  payments   Payment[]
  feedbacks  Feedback[]

  @@index([status])
  @@index([priority])
  @@index([patientId])
  @@index([driverId])
}

model RequestStatusLog {
  id         String           @id @default(cuid())
  requestId  String
  request    EmergencyRequest @relation(fields: [requestId], references: [id])
  actorId    String
  actor      User             @relation(fields: [actorId], references: [id])
  fromStatus RequestStatus?
  toStatus   RequestStatus
  note       String?
  createdAt  DateTime         @default(now())

  @@index([requestId])
}

model Payment {
  id              String           @id @default(cuid())
  requestId       String
  request         EmergencyRequest @relation(fields: [requestId], references: [id])
  patientId       String
  patient         User             @relation(fields: [patientId], references: [id])
  amount          Decimal          @db.Decimal(10, 2)
  currency        String           @default("usd")
  stripeSessionId String?          @unique
  status          PaymentStatus    @default(PENDING)
  createdAt       DateTime         @default(now())

  @@index([requestId])
}

model Feedback {
  id        String           @id @default(cuid())
  requestId String
  request   EmergencyRequest @relation(fields: [requestId], references: [id])
  patientId String
  patient   User             @relation("feedbackPatient", fields: [patientId], references: [id])
  driverId  String
  driver    User             @relation("feedbackDriver", fields: [driverId], references: [id])
  rating    Int
  comment   String?
  deletedAt DateTime?
  createdAt DateTime         @default(now())

  @@index([requestId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
