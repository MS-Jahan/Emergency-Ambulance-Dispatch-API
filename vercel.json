{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "installCommand": "bun install",
  "functions": {
    "api/index.js": {
      "includeFiles": "{dist/**,node_modules/.prisma/client/**,node_modules/@prisma/client/**,docs/openapi.yaml}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
