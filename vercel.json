{
  "version": 2,
  "buildCommand": "bun run build",
  "installCommand": "bun install",
  "builds": [
    {
      "src": "dist/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/.prisma/client/**",
          "node_modules/@prisma/client/**",
          "docs/openapi.yaml"
        ]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "dist/server.js" }]
}
